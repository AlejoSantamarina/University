   "source": [
    "diccionario = {\"Alejo\": 10, \"Pepe\": 5, \"Norberto\": 3, \"Jose\": 7}\n",
    "cantAlumnos = 0\n",
    "totalNotas = 0\n",
    "for nota in diccionario.values():\n",
    "    totalNotas += nota\n",
    "    cantAlumnos += 1\n",
    "promedioNotas = totalNotas/cantAlumnos\n",
    "print(f\"El promedio de nota es: {promedioNotas}\")"
   ]
  }
 ],
