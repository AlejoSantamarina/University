    "def esPar(numero):\n",
    "    resto = numero%2\n",
    "    if(resto == 0):\n",
    "        return \"El numero es par\"\n",
    "    else:\n",
    "        return \"El numero es impar\"\n",
    "\n",
    "print(esPar(5))\n",
    "print(esPar(4))"
   ]
